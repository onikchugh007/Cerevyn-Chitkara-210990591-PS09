# ==============================================================================
# MEMEMIND (PS09) - Credential-Free Configuration Template
# Copy this file to .env for local runtime overrides.
# No secrets or paid API keys are required to run this project.
# ==============================================================================

# Server Environment & Network Binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session Storage Settings
# Set to 'memory' for purely ephemeral in-memory storage (useful during automated tests)
# Defaults to file persistence in server/data/sessions.json
STORAGE_MODE=file

# Optional Cloud Observability (Leave blank for offline execution)
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
